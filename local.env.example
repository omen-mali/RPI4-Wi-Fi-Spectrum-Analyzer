# Setup-specific settings for the host-side scripts (see scripts/local-env.sh).
#
# Copy this file to local.env at the repo root (gitignored), or keep it
# anywhere else and point WSA_LOCAL_ENV at it, for example in a private repo:
#   export WSA_LOCAL_ENV=~/src/my-pi-setup/local.env
# Every line is optional. The values below are examples, not defaults.

# The Pi, as user@host. Used when deploy.sh, measure-timing.sh or ci-local.sh
# aren't given one on the command line. The QNX Quick Start image's user is
# qnxuser, and the host is its address or mDNS name.
#WSA_PI=qnxuser@raspberrypi.local

# Regulatory country (ISO 3166 alpha-2) passed to the app as "-c" in timing
# and smoke runs. Keep it equal to "country=" in the Pi's wpa_supplicant.conf.
# Blank: the app's built-in default (WIFI_COUNTRY_DEFAULT in include/config.h).
#WSA_COUNTRY=US

# Wi-Fi interface passed to the app as "-i". The RPi4 Quick Start image's is
# bcm0, which is also the default.
#WSA_IFACE=bcm0

# Where the QNX SDP and its license directory are (defaults: ~/qnx800, ~/.qnx).
#QNX_SDP_DIR=$HOME/qnx800
#QNX_CONFIG_DIR=$HOME/.qnx
