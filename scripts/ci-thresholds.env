# Pass criteria for the Pi smoke run in scripts/ci-local.sh (sourced by it).
# They don't depend on the RF environment, see scripts/smoke-check.py.

# Wake latency p99 limit in ms. Generous on purpose: there's no clean
# baseline run on the Pi to set it from yet.
CI_WAKE_P99_MAX_MS=2.0

# Fewest APs one scan must see: proves the radio and wpa_supplicant are up.
CI_MIN_APS=1

# Hard limit in seconds on the whole Pi run (upload, capture and fetch).
CI_PI_TIMEOUT=300
